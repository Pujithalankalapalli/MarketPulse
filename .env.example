# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE_URL: Optional PostgreSQL connection URL (e.g. postgresql://user:pass@host:5432/marketpulse).
# If unset, MarketPulse automatically uses its robust built-in persistent disk JSON/SQLite store.
DATABASE_URL=""

# MARKET_API_KEY: Optional external provider key for live stock feeds.
MARKET_API_KEY=""

# NEWS_API_KEY: Optional external financial news feed API key.
NEWS_API_KEY=""
